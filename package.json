{
  "name": "cert-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.9.0"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/pi-telemetry": "workspace:*"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "node scripts/test-integration.mjs",
    "test:py": "node scripts/test-python.mjs",
    "test:real": "node scripts/test-real.mjs",
    "test:official": "node scripts/test-official-vm.mjs",
    "test:rules": "node --import tsx scripts/walkthrough.mjs --rules-only",
    "test:r09": "node scripts/test-r09-vm.mjs",
    "test:knowledge": "node --import tsx scripts/walkthrough.mjs --knowledge-only",
    "test:l08": "node scripts/docsvc-dev.mjs l08",
    "test:e2e": "node scripts/test-e2e.mjs",
    "outbound:simulate": "node --env-file=.env.local --import tsx apps/backend/src/outbound/test-cli.ts",
    "test:network": "node scripts/test-isolated-network.mjs",
    "eval": "node scripts/placeholder.mjs eval",
    "eval:agent": "node scripts/eval-agent.mjs",
    "eval:agent:baseline": "node --import tsx apps/backend/src/agent/evaluation/baseline.ts",
    "k14:collect": "node scripts/k14-public.mjs collect",
    "k14:verify": "node scripts/k14-public.mjs verify",
    "k14:extract-a": "node scripts/k14-pdf.mjs",
    "k14:pair": "node scripts/k14-pairs.mjs collect",
    "k14:verify-pairs": "node scripts/k14-pairs.mjs verify",
    "k14:plan-replay": "node scripts/k14-replay-plan.mjs",
    "k14:draft-r02": "node scripts/k14-r02-draft.mjs",
    "k14:grade-r02": "node scripts/k14-r02-grade.mjs",
    "k14:draft-r01": "node scripts/k14-r01-draft.mjs",
    "eval:r09": "vitest run apps/backend/src/agent/evaluation/r09-extraction.test.ts apps/backend/src/agent/evaluation/r09-l08.test.ts apps/backend/src/rules/rv05.test.ts",
    "docs:html": "node scripts/docs-html.mjs",
    "env:init": "node scripts/init-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --import tsx apps/backend/src/db/cli.ts migrate",
    "db:seed": "node --env-file=.env.local --import tsx apps/backend/src/db/cli.ts seed",
    "db:setup": "node --env-file=.env.local --import tsx apps/backend/src/db/cli.ts setup",
    "skill:stage": "node --env-file=.env.local --import tsx apps/backend/src/skills/cli.ts",
    "knowledge:seed": "node --env-file=.env.local --import tsx apps/backend/src/knowledge/cli.ts",
    "ledger:import": "node --env-file=.env.local --import tsx apps/backend/src/documents/licence-ledger-cli.ts",
    "budget:status": "node --import tsx apps/backend/src/budget/cli.ts",
    "budget:reconcile": "node --import tsx apps/backend/src/budget/cli.ts reconcile",
    "requests:purge": "node --import tsx apps/backend/src/runs/purge-cli.ts",
    "dev:up": "node scripts/dev.mjs up",
    "dev:down": "node scripts/dev.mjs down",
    "dev:status": "node scripts/dev.mjs status",
    "dev:isolated:up": "node scripts/dev.mjs isolated-up",
    "dev:isolated:down": "node scripts/dev.mjs isolated-down",
    "dev:isolated:status": "node scripts/dev.mjs isolated-status",
    "dev:isolated:accounts": "node scripts/dev.mjs isolated-accounts",
    "dev:isolated:web:up": "node scripts/dev.mjs isolated-web-up",
    "dev:isolated:web:down": "node scripts/dev.mjs isolated-web-down",
    "dev:fetcher:up": "node scripts/fetcher-dev.mjs up",
    "dev:fetcher:down": "node scripts/fetcher-dev.mjs down",
    "dev:fetcher:status": "node scripts/fetcher-dev.mjs status",
    "dev:docsvc:up": "node scripts/docsvc-dev.mjs up",
    "dev:docsvc:down": "node scripts/docsvc-dev.mjs down",
    "dev:docsvc:status": "node scripts/docsvc-dev.mjs status",
    "dev:sandbox:up": "node scripts/sandbox-dev.mjs up",
    "dev:sandbox:down": "node scripts/sandbox-dev.mjs down",
    "dev:sandbox:status": "node scripts/sandbox-dev.mjs status",
    "dev:api": "node scripts/start-backend.mjs api",
    "dev:worker": "node scripts/start-backend.mjs worker",
    "dev:verification": "node scripts/start-backend.mjs verification",
    "dev:web": "pnpm --filter @cert-board/web dev",
    "build": "pnpm --filter @cert-board/web build",
    "preview": "pnpm --filter @cert-board/web preview",
    "preview:lan": "node --import tsx scripts/preview.mjs lan",
    "preview:walkthrough": "node --import tsx scripts/preview.mjs walkthrough",
    "walkthrough:real": "node --import tsx scripts/walkthrough.mjs",
    "walkthrough:batch": "node --import tsx scripts/walkthrough.mjs --batch",
    "format": "prettier --write apps packages scripts *.json *.mjs *.yaml",
    "security:scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "jsdom": "27.2.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
