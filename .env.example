# 复制为 .env.local 后填写。.env.local 不提交，其中的值不要打印或写进日志。
# PR-01及之后的PR会补充其余变量。

# 可运行 pnpm env:init 生成本机依赖凭据，不会覆盖已有值。
NODE_ENV=development
HOST=127.0.0.1
PORT=28081
LOG_LEVEL=info
WEB_ORIGIN=http://127.0.0.1:28080
SESSION_TTL_HOURS=12
POSTGRES_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=
MINIO_ROOT_USER=certboard
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=29000
MINIO_USE_SSL=false
MINIO_BUCKET=cert-board

# 开发账号种子，仅development/test可用；env:init自动生成，密码不写入文档。
DEV_ZHANGSAN_PASSWORD=
DEV_WANGMIN_PASSWORD=
DEV_ADMIN_PASSWORD=

# 模型：OpenRouter key
OPENROUTER_API_KEY=
# 本地 OpenAI 兼容地址按 X4 留空。设置后优先于开发模拟模型。
CERT_LOCAL_MODEL_BASE_URL=
# 可选开发模型配置编号。留空使用 deploy/models.yaml 的默认模拟模型。
CERT_DEV_MODEL_ID=
EXTERNAL_MODEL_MONTHLY_USD=20
# 本机 Cursor 核实进程。使用团队的已登录订阅，独立配置目录内只启用经过审查的权限。
CERT_CURSOR_BUNDLE=
CERT_CURSOR_PROFILE=
CERT_CURSOR_PRIVACY_CONFIRMED=0
HTTPS_PROXY=http://127.0.0.1:28085
# 独立网页抓取服务。启用后 Agent 提供抓取和检索入口。
CERT_FETCHER_URL=http://127.0.0.1:28084
# 独立资料解析服务。后台进程使用此回环地址领取待解析版本。
CERT_DOCSVC_URL=http://127.0.0.1:28082
# 可选的扩展来源域名，以逗号分隔。只影响来源标记。
CERT_WEB_EXTENDED_HOSTS=

# 参考资料快照目录与其中的数据目录（L08原始资料）
CERT_REF_DIR=C:\Users\yc2bgr8\Desktop\MDC\handoff\cert-board-ref_2026-11-17
CERT_DATA_DIR=C:\Users\yc2bgr8\Desktop\MDC\handoff\cert-board-ref_2026-11-17\data
